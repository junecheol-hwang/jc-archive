---
const { title, description, pubDate, category, template = 'A', heroImage } = Astro.props;

const catClass = 
  category === 'vibe coding' ? 'cat-code' :
  category === 'photos' ? 'cat-art' :
  category === 'books' ? 'cat-book' : 'cat-essay';

const dateStr = pubDate 
  ? new Date(pubDate).toISOString().slice(0, 7).replace('-', '.')
  : '';
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;1,400&family=DM+Mono:wght@300;400&family=Noto+Serif+KR:wght@300;400&display=swap');
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'DM Mono', monospace; background: #faf9f7; color: #1a1a18; }
    .wrapper { max-width: 1080px; margin: 0 auto; }

    /* 네비게이션 */
    .nav { display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 2rem; border-bottom: 0.5px solid #e2e0d8; }
    .nav-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: inherit; }
    .nav-logo-text { font-family: 'Playfair Display', serif; font-size: 15px; font-style: italic; letter-spacing: -0.01em; }
    .nav-back { font-size: 9px; letter-spacing: 0.15em; text-transform: uppercase; color: #888780; text-decoration: none; }
    .nav-back:hover { color: #1a1a18; }

    /* 공통 헤더 */
    .post-header { padding: 1rem 2rem; border-bottom: 0.5px solid #e2e0d8; display: flex; justify-content: space-between; align-items: center; }
    .post-cat { font-size: 8px; letter-spacing: 0.15em; text-transform: uppercase; padding: 2px 6px; }
    .cat-code { border: 0.5px solid #5DCAA5; color: #0F6E56; }
    .cat-art  { border: 0.5px solid #F0997B; color: #993C1D; }
    .cat-book { border: 0.5px solid #AFA9EC; color: #3C3489; }
    .cat-essay{ border: 0.5px solid #B4B2A9; color: #5F5E5A; }
    .post-date { font-size: 9px; color: #aaa89f; }

    /* 본문 공통 */
    .post-title { font-family: 'Playfair Display', serif; font-weight: 400; letter-spacing: -0.02em; color: #1a1a18; }
    .post-desc { font-family: 'Noto Serif KR', serif; font-weight: 300; color: #888780; line-height: 1.9; font-size: 11px; }
    .post-body { font-family: 'Noto Serif KR', serif; font-weight: 300; font-size: 13px; line-height: 2; color: #444; }
    .post-body p { margin-bottom: 1.25rem; }
    .post-body h2 { font-family: 'Playfair Display', serif; font-size: 18px; font-weight: 400; margin: 2rem 0 0.75rem; }
    .post-body img { width: 100%; height: auto; display: block; margin: 1.5rem 0; }
    .post-body video { width: 100%; display: block; margin: 1.5rem 0; }
    .post-body iframe { width: 100%; aspect-ratio: 16/9; display: block; margin: 1.5rem 0; border: none; }
    .divider { height: 0.5px; background: #e2e0d8; margin: 1rem 0; }

    /* A — 전면 이미지형 */
    .tpl-a .hero-img { width: 100%; max-height: 480px; object-fit: cover; display: block; }
    .tpl-a .post-content { padding: 2rem; }
    .tpl-a .post-title { font-size: 32px; line-height: 1.05; margin-bottom: 1rem; }
    .tpl-a .post-desc { margin-bottom: 1.5rem; }

    /* B — 좌우 분할형 */
    .tpl-b .post-body-wrap { display: grid; grid-template-columns: 1fr 1fr; min-height: 400px; }
    .tpl-b .hero-img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .tpl-b .post-content { padding: 2rem; display: flex; flex-direction: column; gap: 1rem; border-left: 0.5px solid #e2e0d8; }
    .tpl-b .post-title { font-size: 24px; line-height: 1.1; }

    /* C — 본문 중간 이미지형 */
    .tpl-c .post-content { padding: 2rem; }
    .tpl-c .post-title { font-size: 28px; line-height: 1.05; margin-bottom: 0.75rem; }
    .tpl-c .post-desc { margin-bottom: 1.5rem; }

    /* D — 타이포그래피 중심형 */
    .tpl-d .post-content { padding: 3rem 2rem; max-width: 680px; }
    .tpl-d .post-title { font-size: 40px; line-height: 1.05; margin-bottom: 1.5rem; }
    .tpl-d .post-title em { font-style: italic; color: #888780; }

    /* 푸터 */
    .footer { padding: 1.25rem 2rem; border-top: 0.5px solid #e2e0d8; display: flex; justify-content: space-between; }
    .footer-note { font-size: 9px; color: #aaa89f; }

    /* 모바일 */
    @media (max-width: 680px) {
      .nav { padding: 1rem 1.25rem; }
      .post-header { padding: 1rem 1.25rem; }
      .tpl-b .post-body-wrap { grid-template-columns: 1fr; }
      .tpl-b .post-content { border-left: none; border-top: 0.5px solid #e2e0d8; padding: 1.25rem; }
      .tpl-a .post-content,
      .tpl-c .post-content { padding: 1.25rem; }
      .tpl-d .post-content { padding: 2rem 1.25rem; }
      .tpl-a .post-title { font-size: 24px; }
      .tpl-b .post-title { font-size: 20px; }
      .tpl-c .post-title { font-size: 22px; }
      .tpl-d .post-title { font-size: 28px; }
      .footer { padding: 1rem 1.25rem; }
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <nav class="nav">
      <a href="/" class="nav-brand">
        <svg viewBox="-90 -90 180 180" width="33" height="33" style="flex-shrink:0">
          <circle cx="0" cy="0" r="33" fill="none" stroke="currentColor" stroke-width="1.2"/>
          <circle cx="0" cy="0" r="16" fill="none" stroke="currentColor" stroke-width="1.2"/>
          <circle cx="0" cy="0" r="5" fill="currentColor"/>
          <circle cx="46" cy="0" r="3.5" fill="currentColor"/>
          <circle cx="32.5" cy="-32.5" r="3.5" fill="currentColor"/>
          <circle cx="0" cy="-46" r="3.5" fill="currentColor"/>
          <circle cx="-32.5" cy="-32.5" r="3.5" fill="currentColor"/>
          <circle cx="-46" cy="0" r="3.5" fill="currentColor"/>
          <circle cx="-32.5" cy="32.5" r="3.5" fill="currentColor"/>
          <circle cx="0" cy="46" r="3.5" fill="currentColor"/>
          <circle cx="32.5" cy="32.5" r="3.5" fill="currentColor"/>
        </svg>
        <span class="nav-logo-text">archive</span>
      </a>
      <a href="/" class="nav-back">← 목록으로</a>
    </nav>

    <div class="post-header">
      <span class={`post-cat ${catClass}`}>{category ?? 'thoughts'}</span>
      <span class="post-date">{dateStr}</span>
    </div>

    {template === 'A' && (
      <div class="tpl-a">
        {heroImage && <img class="hero-img" src={heroImage.src} alt={title} />}
        <div class="post-content">
          <h1 class="post-title">{title}</h1>
          <p class="post-desc">{description}</p>
          <div class="divider"></div>
          <div class="post-body"><slot /></div>
        </div>
      </div>
    )}

    {template === 'B' && (
      <div class="tpl-b">
        <div class="post-body-wrap">
          {heroImage && <img class="hero-img" src={heroImage.src} alt={title} />}
          <div class="post-content">
            <h1 class="post-title">{title}</h1>
            <p class="post-desc">{description}</p>
            <div class="divider"></div>
            <div class="post-body"><slot /></div>
          </div>
        </div>
      </div>
    )}

    {template === 'C' && (
      <div class="tpl-c">
        <div class="post-content">
          <h1 class="post-title">{title}</h1>
          <p class="post-desc">{description}</p>
          <div class="post-body"><slot /></div>
        </div>
      </div>
    )}

    {template === 'D' && (
      <div class="tpl-d">
        <div class="post-content">
          <h1 class="post-title" set:html={title}></h1>
          <div class="divider"></div>
          <div class="post-body"><slot /></div>
        </div>
      </div>
    )}

    <div class="footer">
      <span class="footer-note">© 직접 만든 것들</span>
      <span class="footer-note"><a href="/" class="nav-back">← 목록으로</a></span>
    </div>
  </div>
</body>
</html>