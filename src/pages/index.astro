                <circle cx="0" cy="0" r="33" fill="none" stroke="#444441" stroke-width="1.5" opacity="0.5"/>
                <circle cx="0" cy="0" r="16" fill="none" stroke="#444441" stroke-width="1.5" opacity="0.5"/>
                <circle cx="0" cy="0" r="3" fill="#444441" opacity="0.3"/>
                <circle cx="46" cy="0" r="9" fill="#7F77DD" opacity="0.15"/><circle cx="46" cy="0" r="6" fill="#7F77DD" opacity="0.4"/><circle cx="46" cy="0" r="3.5" fill="#7F77DD"/>
                <circle cx="32.5" cy="-32.5" r="9" fill="#7F77DD" opacity="0.15"/><circle cx="32.5" cy="-32.5" r="6" fill="#7F77DD" opacity="0.4"/><circle cx="32.5" cy="-32.5" r="3.5" fill="#7F77DD"/>
                <circle cx="0" cy="-46" r="9" fill="#7F77DD" opacity="0.15"/><circle cx="0" cy="-46" r="6" fill="#7F77DD" opacity="0.4"/><circle cx="0" cy="-46" r="3.5" fill="#7F77DD"/>
                <circle cx="-32.5" cy="-32.5" r="9" fill="#7F77DD" opacity="0.15"/><circle cx="-32.5" cy="-32.5" r="6" fill="#7F77DD" opacity="0.4"/><circle cx="-32.5" cy="-32.5" r="3.5" fill="#7F77DD"/>
                <circle cx="-46" cy="0" r="9" fill="#7F77DD" opacity="0.15"/><circle cx="-46" cy="0" r="6" fill="#7F77DD" opacity="0.4"/><circle cx="-46" cy="0" r="3.5" fill="#7F77DD"/>
                <circle cx="-32.5" cy="32.5" r="9" fill="#7F77DD" opacity="0.15"/><circle cx="-32.5" cy="32.5" r="6" fill="#7F77DD" opacity="0.4"/><circle cx="-32.5" cy="32.5" r="3.5" fill="#7F77DD"/>
                <circle cx="0" cy="46" r="9" fill="#7F77DD" opacity="0.15"/><circle cx="0" cy="46" r="6" fill="#7F77DD" opacity="0.4"/><circle cx="0" cy="46" r="3.5" fill="#7F77DD"/>
                <circle cx="32.5" cy="32.5" r="9" fill="#7F77DD" opacity="0.15"/><circle cx="32.5" cy="32.5" r="6" fill="#7F77DD" opacity="0.4"/><circle cx="32.5" cy="32.5" r="3.5" fill="#7F77DD"/>
              </svg>
            </span>
            <span class="nav-label">all</span>
          </button>
          <div class="nav-sep"><div class="sep-yang"></div></div>
          <button class="nav-link">
            <span class="nav-icon">
              <svg viewBox="-90 -90 180 180" width="33" height="33">
                <circle cx="0" cy="0" r="33" fill="none" stroke="#444441" stroke-width="1.5" opacity="0.5"/>
                <circle cx="0" cy="0" r="16" fill="none" stroke="#444441" stroke-width="1.5" opacity="0.5"/>
                <circle cx="0" cy="0" r="3" fill="#444441" opacity="0.3"/>
                <circle cx="32.5" cy="-32.5" r="3" fill="#888780" opacity="0.5"/><circle cx="0" cy="-46" r="3" fill="#888780" opacity="0.5"/><circle cx="-32.5" cy="-32.5" r="3" fill="#888780" opacity="0.5"/><circle cx="-46" cy="0" r="3" fill="#888780" opacity="0.5"/><circle cx="-32.5" cy="32.5" r="3" fill="#888780" opacity="0.5"/><circle cx="0" cy="46" r="3" fill="#888780" opacity="0.5"/><circle cx="32.5" cy="32.5" r="3" fill="#888780" opacity="0.5"/>
                <circle cx="46" cy="0" r="9" fill="#7F77DD" opacity="0.15"/><circle cx="46" cy="0" r="6" fill="#7F77DD" opacity="0.4"/><circle cx="46" cy="0" r="3.5" fill="#7F77DD"/>
              </svg>
            </span>
            <span class="nav-label">vibe coding</span>
          </button>
          <div class="nav-sep"><div class="sep-eum"><span></span><span></span></div></div>
          <button class="nav-link">
            <span class="nav-icon">
              <svg viewBox="-90 -90 180 180" width="33" height="33">
                <circle cx="0" cy="0" r="33" fill="none" stroke="#444441" stroke-width="1.5" opacity="0.5"/>
                <circle cx="0" cy="0" r="16" fill="none" stroke="#444441" stroke-width="1.5" opacity="0.5"/>
                <circle cx="0" cy="0" r="3" fill="#444441" opacity="0.3"/>
                <circle cx="46" cy="0" r="3" fill="#888780" opacity="0.5"/><circle cx="32.5" cy="-32.5" r="3" fill="#888780" opacity="0.5"/><circle cx="0" cy="-46" r="3" fill="#888780" opacity="0.5"/><circle cx="-32.5" cy="-32.5" r="3" fill="#888780" opacity="0.5"/><circle cx="-46" cy="0" r="3" fill="#888780" opacity="0.5"/><circle cx="-32.5" cy="32.5" r="3" fill="#888780" opacity="0.5"/><circle cx="32.5" cy="32.5" r="3" fill="#888780" opacity="0.5"/>
                <circle cx="0" cy="46" r="9" fill="#7F77DD" opacity="0.15"/><circle cx="0" cy="46" r="6" fill="#7F77DD" opacity="0.4"/><circle cx="0" cy="46" r="3.5" fill="#7F77DD"/>
              </svg>
            </span>
            <span class="nav-label">photos</span>
          </button>
          <div class="nav-sep"><div class="sep-yang"></div></div>
          <button class="nav-link">
            <span class="nav-icon">
              <svg viewBox="-90 -90 180 180" width="33" height="33">
                <circle cx="0" cy="0" r="33" fill="none" stroke="#444441" stroke-width="1.5" opacity="0.5"/>
                <circle cx="0" cy="0" r="16" fill="none" stroke="#444441" stroke-width="1.5" opacity="0.5"/>
                <circle cx="0" cy="0" r="3" fill="#444441" opacity="0.3"/>
                <circle cx="46" cy="0" r="3" fill="#888780" opacity="0.5"/><circle cx="32.5" cy="-32.5" r="3" fill="#888780" opacity="0.5"/><circle cx="0" cy="-46" r="3" fill="#888780" opacity="0.5"/><circle cx="-32.5" cy="-32.5" r="3" fill="#888780" opacity="0.5"/><circle cx="-32.5" cy="32.5" r="3" fill="#888780" opacity="0.5"/><circle cx="0" cy="46" r="3" fill="#888780" opacity="0.5"/><circle cx="32.5" cy="32.5" r="3" fill="#888780" opacity="0.5"/>
                <circle cx="-46" cy="0" r="9" fill="#7F77DD" opacity="0.15"/><circle cx="-46" cy="0" r="6" fill="#7F77DD" opacity="0.4"/><circle cx="-46" cy="0" r="3.5" fill="#7F77DD"/>
              </svg>
            </span>
            <span class="nav-label">books</span>
          </button>
          <div class="nav-sep"><div class="sep-eum"><span></span><span></span></div></div>
          <button class="nav-link">
            <span class="nav-icon">
              <svg viewBox="-90 -90 180 180" width="33" height="33">
                <circle cx="0" cy="0" r="33" fill="none" stroke="#444441" stroke-width="1.5" opacity="0.5"/>
                <circle cx="0" cy="0" r="16" fill="none" stroke="#444441" stroke-width="1.5" opacity="0.5"/>
                <circle cx="0" cy="0" r="3" fill="#444441" opacity="0.3"/>
                <circle cx="46" cy="0" r="3" fill="#888780" opacity="0.5"/><circle cx="32.5" cy="-32.5" r="3" fill="#888780" opacity="0.5"/><circle cx="-32.5" cy="-32.5" r="3" fill="#888780" opacity="0.5"/><circle cx="-46" cy="0" r="3" fill="#888780" opacity="0.5"/><circle cx="-32.5" cy="32.5" r="3" fill="#888780" opacity="0.5"/><circle cx="0" cy="46" r="3" fill="#888780" opacity="0.5"/><circle cx="32.5" cy="32.5" r="3" fill="#888780" opacity="0.5"/>
                <circle cx="0" cy="-46" r="9" fill="#7F77DD" opacity="0.15"/><circle cx="0" cy="-46" r="6" fill="#7F77DD" opacity="0.4"/><circle cx="0" cy="-46" r="3.5" fill="#7F77DD"/>
              </svg>
