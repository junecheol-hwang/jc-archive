---
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<!doctype html>
<html lang="ko">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&family=DM+Mono:wght@300;400&family=Noto+Serif+KR:wght@300;400&display=swap');
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'DM Mono', monospace; background: #faf9f7; color: #1a1a18; }
      .wrapper { max-width: 1080px; margin: 0 auto; }

      /* 네비게이션 */
      .nav { display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 2rem; border-bottom: 0.5px solid #e2e0d8; }
      .nav-brand { display: flex; align-items: center; gap: 10px; }
      .nav-logo-text { font-family: 'Playfair Display', serif; font-size: 15px; font-style: italic; font-weight: 700; letter-spacing: -0.01em; color: #3C3489; }
      .nav-links { display: flex; align-items: center; }
      .nav-sep { width: 20px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; flex-shrink: 0; }
      .sep-yang { width: 10px; height: 1px; background: #c8c6be; }
      .sep-eum { display: flex; gap: 2px; }
      .sep-eum span { width: 4px; height: 1px; background: #c8c6be; }
      .nav-link { width: 72px; height: 44px; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; border: none !important; outline: none !important; background: none !important; box-shadow: none !important; -webkit-appearance: none; appearance: none; position: relative; flex-shrink: 0; }
      .nav-icon { transition: opacity 0.18s; display: flex; align-items: center; justify-content: center; }
      .nav-link:hover .nav-icon { opacity: 0; }
      .nav-label { font-family: 'Playfair Display', serif; font-size: 12px; font-style: italic; color: #444441; white-space: nowrap; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); opacity: 0; transition: opacity 0.18s; pointer-events: none; }
      .nav-link:hover .nav-label { opacity: 1; color: #1a1a18; }
      .nav-link.active .nav-label { font-weight: 700; }
      .hamburger { display: none; flex-direction: column; gap: 5px; cursor: pointer; border: none; background: none; padding: 4px; }
      .hamburger span { width: 20px; height: 0.5px; background: #444441; display: block; }
      .mobile-menu { display: none; flex-direction: column; padding: 1rem 1.25rem; border-bottom: 0.5px solid #e2e0d8; gap: 1rem; }
      .mobile-menu.open { display: flex; }
      .mobile-menu-link { font-family: 'Playfair Display', serif; font-size: 15px; font-style: italic; color: #444441; background: none; border: none; padding: 0; cursor: pointer; text-align: left; }
      .mobile-menu-link.active { color: #1a1a18; font-weight: 700; }

      /* 슬라이더 */
      .slider-wrap { position: relative; width: 100%; height: 360px; overflow: hidden; background: #fff; border-bottom: 0.5px solid #e2e0d8; }
      .slides-track { display: flex; height: 100%; transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1); }
      .slide { min-width: 100%; height: 100%; position: relative; background: #fff; overflow: hidden; }

      /* 서예 이미지 */
      .slide-img { position: absolute; inset: 0; }
      .slide-img img { width: 100%; height: 100%; object-fit: contain; }

      /* 텍스트 공통 */
      .slide-text { position: absolute; z-index: 2; font-family: 'Playfair Display', serif; font-weight: 400; letter-spacing: -0.02em; }
      .slide-text .kr { font-size: 28px; line-height: 1.15; color: #1a1a18; display: block; }
      .slide-text .en { font-size: 11px; font-style: italic; color: #5F5E5A; display: block; margin-top: 6px; }
      .slide-text .meta { font-family: 'DM Mono', monospace; font-size: 8px; letter-spacing: 0.15em; text-transform: uppercase; color: #888780; display: block; margin-top: 10px; }

      /* 구도 A: 왼쪽 하단 */
      .layout-a .slide-text { bottom: 2.5rem; left: 2.5rem; }
      .layout-a .slide-text .kr,
      .layout-a .slide-text .en,
      .layout-a .slide-text .meta { background: linear-gradient(to right, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.92) 70%, rgba(255,255,255,0) 100%); padding-right: 40px; }

      /* 구도 B: 오른쪽 중앙 */
      .layout-b .slide-text { top: 50%; right: 2.5rem; transform: translateY(-50%); text-align: right; }
      .layout-b .slide-text .kr,
      .layout-b .slide-text .en,
      .layout-b .slide-text .meta { background: linear-gradient(to left, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.92) 70%, rgba(255,255,255,0) 100%); padding-left: 40px; }

      /* 구도 C: 상단 중앙 */
      .layout-c .slide-text { top: 2.5rem; left: 50%; transform: translateX(-50%); text-align: center; white-space: nowrap; }
      .layout-c .slide-text .kr,
      .layout-c .slide-text .en,
      .layout-c .slide-text .meta { background: radial-gradient(ellipse at center, rgba(255,255,255,0.98) 40%, rgba(255,255,255,0) 100%); padding: 2px 28px; }

      /* 화살표 */
      .arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 10; width: 36px; height: 36px; border: 0.5px solid #e2e0d8; background: rgba(255,255,255,0.9); cursor: pointer; display: flex; align-items: center; justify-content: center; font-family: 'DM Mono', monospace; font-size: 14px; color: #444441; transition: background 0.15s; }
      .arrow:hover { background: #fff; color: #1a1a18; }
      .arrow.left { left: 1.25rem; }
      .arrow.right { right: 1.25rem; }

      /* 점 */
      .dots { position: absolute; bottom: 1rem; left: 50%; transform: translateX(-50%); display: flex; gap: 6px; z-index: 10; }
      .dot { width: 4px; height: 4px; border-radius: 50%; background: #c8c6be; cursor: pointer; transition: background 0.2s, transform 0.2s; }
      .dot.active { background: #7F77DD; transform: scale(1.3); }

      /* 카드 섹션 */
      .section { padding: 1.5rem 2rem; }
      .section-label { font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase; color: #888780; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 1rem; }
      .section-label::after { content: ''; flex: 1; height: 0.5px; background: #e2e0d8; }
      .card-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
      .card { padding: 1.25rem 1rem; border-right: 0.5px solid #e2e0d8; border-top: 0.5px solid #e2e0d8; position: relative; overflow: hidden; cursor: pointer; text-decoration: none; color: inherit; display: block; }
      .card:last-child { border-right: none; }
      .card-yao { position: absolute; top: 0; left: 0; right: 0; height: 6px; display: flex; align-items: center; padding: 0 12px; gap: 4px; opacity: 0; transition: opacity 0.2s; }
      .card:hover .card-yao { opacity: 1; }
      .yao-yang { flex: 1; height: 1.5px; background: #1a1a18; }
      .yao-eum-l { width: 42%; height: 1.5px; background: #1a1a18; }
      .yao-eum-r { width: 42%; height: 1.5px; background: #1a1a18; }
      .card-num { font-size: 9px; color: #888780; margin-bottom: 0.6rem; margin-top: 0.5rem; }
      .card-tag { display: inline-block; font-size: 8px; letter-spacing: 0.12em; text-transform: uppercase; padding: 2px 6px; margin-bottom: 0.6rem; }
      .tag-code  { border: 0.5px solid #5DCAA5; color: #0F6E56; }
      .tag-art   { border: 0.5px solid #F0997B; color: #993C1D; }
      .tag-book  { border: 0.5px solid #AFA9EC; color: #3C3489; }
      .tag-essay { border: 0.5px solid #B4B2A9; color: #5F5E5A; }
      .card-title { font-family: 'Playfair Display', serif; font-size: 13px; line-height: 1.35; font-weight: 400; margin-bottom: 0.75rem; color: #1a1a18; }
      .card-date { font-size: 9px; color: #888780; }
      .footer { padding: 1.25rem 2rem; border-top: 0.5px solid #e2e0d8; display: flex; justify-content: space-between; }
      .footer-note { font-size: 9px; color: #888780; }

      @media (max-width: 680px) {
        .nav { padding: 1rem 1.25rem; }
        .nav-links { display: none; }
        .hamburger { display: flex; }
        .slider-wrap { height: 260px; }
        .slide-text .kr { font-size: 22px; }
        .section { padding: 1rem 1.25rem; }
        .card-grid { grid-template-columns: 1fr; }
        .card { display: flex; align-items: center; gap: 1rem; border-right: none; padding: 0.875rem 0; margin: 0 1.25rem; }
        .card-yao { display: none; }
        .card-num { margin: 0; min-width: 28px; }
        .card-tag { margin: 0; }
        .card-title { margin: 0; font-size: 12px; }
        .card-date { margin-left: auto; white-space: nowrap; }
        .footer { padding: 1rem 1.25rem; }
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <nav class="nav">
        <div class="nav-brand">
          <svg viewBox="-90 -90 180 180" width="33" height="33" style="flex-shrink:0">
            <circle cx="0" cy="0" r="33" fill="none" stroke="#AFA9EC" stroke-width="1" opacity="0.5"/>
            <circle cx="0" cy="0" r="16" fill="none" stroke="#AFA9EC" stroke-width="1" opacity="0.5"/>
            <circle cx="0" cy="0" r="8" fill="#AFA9EC" opacity="0.2"/><circle cx="0" cy="0" r="5" fill="#AFA9EC" opacity="0.4"/><circle cx="0" cy="0" r="3.5" fill="#7F77DD"/>
            <circle cx="46" cy="0" r="7" fill="#AFA9EC" opacity="0.2"/><circle cx="46" cy="0" r="4.5" fill="#AFA9EC" opacity="0.4"/><circle cx="46" cy="0" r="3" fill="#7F77DD"/>
            <circle cx="32.5" cy="-32.5" r="7" fill="#AFA9EC" opacity="0.2"/><circle cx="32.5" cy="-32.5" r="4.5" fill="#AFA9EC" opacity="0.4"/><circle cx="32.5" cy="-32.5" r="3" fill="#7F77DD"/>
            <circle cx="0" cy="-46" r="7" fill="#AFA9EC" opacity="0.2"/><circle cx="0" cy="-46" r="4.5" fill="#AFA9EC" opacity="0.4"/><circle cx="0" cy="-46" r="3" fill="#7F77DD"/>
            <circle cx="-32.5" cy="-32.5" r="7" fill="#AFA9EC" opacity="0.2"/><circle cx="-32.5" cy="-32.5" r="4.5" fill="#AFA9EC" opacity="0.4"/><circle cx="-32.5" cy="-32.5" r="3" fill="#7F77DD"/>
            <circle cx="-46" cy="0" r="7" fill="#AFA9EC" opacity="0.2"/><circle cx="-46" cy="0" r="4.5" fill="#AFA9EC" opacity="0.4"/><circle cx="-46" cy="0" r="3" fill="#7F77DD"/>
            <circle cx="-32.5" cy="32.5" r="7" fill="#AFA9EC" opacity="0.2"/><circle cx="-32.5" cy="32.5" r="4.5" fill="#AFA9EC" opacity="0.4"/><circle cx="-32.5" cy="32.5" r="3" fill="#7F77DD"/>
            <circle cx="0" cy="46" r="7" fill="#AFA9EC" opacity="0.2"/><circle cx="0" cy="46" r="4.5" fill="#AFA9EC" opacity="0.4"/><circle cx="0" cy="46" r="3" fill="#7F77DD"/>
            <circle cx="32.5" cy="32.5" r="7" fill="#AFA9EC" opacity="0.2"/><circle cx="32.5" cy="32.5" r="4.5" fill="#AFA9EC" opacity="0.4"/><circle cx="32.5" cy="32.5" r="3" fill="#7F77DD"/>
          </svg>
          <span class="nav-logo-text">jc archive</span>
        </div>
        <div class="nav-links">
          <button class="nav-link active">
            <span class="nav-icon">
