        <button class="hamburger" id="hamburger" aria-label="메뉴 열기">
          <span></span><span></span><span></span>
        </button>
      </nav>

      <div class="mobile-menu" id="mobile-menu">
        <button class="mobile-menu-link active">all</button>
        <button class="mobile-menu-link">vibe coding</button>
        <button class="mobile-menu-link">photos</button>
        <button class="mobile-menu-link">books</button>
        <button class="mobile-menu-link">thoughts</button>
      </div>

      <!-- 슬라이더 -->
      <div class="slider-wrap">
        <div class="slides-track" id="track"></div>
        <button class="arrow left" id="prev">←</button>
        <button class="arrow right" id="next">→</button>
        <div class="dots" id="dots"></div>
      </div>

      <div class="section">
        <div class="section-label">최근 기록</div>
        <div class="card-grid">
          {posts.map((post, i) => (
            <a href={`/blog/${post.id}/`} class="card">
              <div class="card-yao">
                {i % 2 === 0
                  ? <div class="yao-yang"></div>
                  : <><div class="yao-eum-l"></div><div class="yao-eum-r"></div></>
                }
              </div>
              <div class="card-num">{String(i + 1).padStart(3, '0')}</div>
              <div>
                <span class={`card-tag tag-${
                  post.data.category === 'vibe coding' ? 'code' :
                  post.data.category === 'photos' ? 'art' :
                  post.data.category === 'books' ? 'book' : 'essay'
                }`}>
                  {post.data.category ?? 'thoughts'}
                </span>
              </div>
              <div class="card-title">{post.data.title}</div>
              <div class="card-date">
                {new Date(post.data.pubDate).toISOString().slice(0, 7).replace('-', '.')}
              </div>
            </a>
          ))}
        </div>
      </div>

      <div class="footer">
        <span class="footer-note">© 직접 만든 것들</span>
        <span class="footer-note">소개</span>
      </div>
    </div>

    <script>
      // ─── 데이터 ───────────────────────────────────────────
      // 이미지: public/calligraphy/ 폴더에 넣으세요
      const IMAGES = [
        '/calligraphy/image-1.jpg',
        '/calligraphy/image-2.jpg',
        '/calligraphy/image-3.jpg',
        '/calligraphy/image-4.jpg',
        '/calligraphy/image-5.jpg',
      ];

      // 아포리즘: 나중에 하나씩 갈아끼우세요
      const TEXTS = [
        { kr: '누가 보지 않아도\n괜찮다.', en: 'It is enough to see, even unseen.' },
        { kr: '기록은\n기억보다 오래 산다.', en: 'The record outlives the memory.' },
        { kr: '변하는 것 안에\n변하지 않는 것이 있다.', en: 'Within change, that which does not change.' },
        { kr: '가장 단순한 것이\n가장 오래 남는다.', en: 'The simplest things endure the longest.' },
        { kr: '빛은 그림자가\n있어야 보인다.', en: 'Light is only seen where shadow falls.' },
        { kr: '보는 것은\n이미 기억하는 것이다.', en: 'To see is already to remember.' },
        { kr: '침묵도\n하나의 언어다.', en: 'Silence too is a language.' },
        { kr: '아름다움은 설명하지 않아도\n전해진다.', en: 'Beauty needs no explanation to be felt.' },
        { kr: '지나간 것들이\n현재를 만든다.', en: 'What has passed makes the present.' },
        { kr: '작은 것들이 모여\n큰 것이 된다.', en: 'Small things gathered become something great.' },
      ];

      const LAYOUTS = ['layout-a', 'layout-b', 'layout-c'];
      const TOTAL = 5;

      // ─── 랜덤 유틸 ───────────────────────────────────────
      function shuffle(arr) {
        return [...arr].sort(() => Math.random() - 0.5);
      }
      function pick(arr) {
        return arr[Math.floor(Math.random() * arr.length)];
      }

      // ─── 슬라이드 생성 ───────────────────────────────────
      const track = document.getElementById('track');
      const dotsWrap = document.getElementById('dots');
      const shuffledTexts = shuffle(TEXTS);

      for (let i = 0; i < TOTAL; i++) {
        const img = IMAGES[i];
        const text = shuffledTexts[i % shuffledTexts.length];
        const layout = pick(LAYOUTS);
        const kr = text.kr.replace('\n', '<br>');

        const slide = document.createElement('div');
        slide.className = `slide ${layout}`;
        slide.innerHTML = `
          <div class="slide-img">
            <img src="${img}" alt="서예 ${i + 1}" onerror="this.style.display='none'">
          </div>
          <div class="slide-text">
            <span class="kr">${kr}</span>
            <span class="en">${text.en}</span>
            <span class="meta">jc archive</span>
          </div>
        `;
        track.appendChild(slide);

        const dot = document.createElement('div');
        dot.className = `dot${i === 0 ? ' active' : ''}`;
        dot.dataset.i = i;
        dotsWrap.appendChild(dot);
      }

      // ─── 슬라이더 로직 ───────────────────────────────────
      let current = 0;

      function goTo(i) {
        current = (i + TOTAL) % TOTAL;
        track.style.transform = `translateX(-${current * 100}%)`;
        document.querySelectorAll('.dot').forEach((d, idx) =>
          d.classList.toggle('active', idx === current)
        );
      }

      document.getElementById('prev').addEventListener('click', () => goTo(current - 1));
      document.getElementById('next').addEventListener('click', () => goTo(current + 1));
      dotsWrap.addEventListener('click', e => {
        if (e.target.classList.contains('dot')) goTo(+e.target.dataset.i);
      });

      // ─── 햄버거 ──────────────────────────────────────────
      const btn = document.getElementById('hamburger');
      const menu = document.getElementById('mobile-menu');
      btn.addEventListener('click', () => menu.classList.toggle('open'));
    </script>
  </body>
</html>